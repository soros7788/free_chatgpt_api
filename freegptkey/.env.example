# freegptkey 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ──────────────────────────────────────────────────────────────
# 免费 GPT API KEY（必需或在调用工具时传入 api_key 参数）
# 获取地址: https://free.v36.cm/github
# 领取方式: 使用 GitHub 账号登录授权后自动生成
# ──────────────────────────────────────────────────────────────
FREE_GPT_API_KEY=sk-你的免费API_KEY_在这里

# ──────────────────────────────────────────────────────────────
# 高级配置（可选，一般不需要修改）
# ──────────────────────────────────────────────────────────────

# API 基础地址（默认为 https://free.v36.cm/v1）
FREE_GPT_API_URL=https://free.v36.cm/v1

# API 主机地址（默认为 https://free.v36.cm）
FREE_GPT_BASE_URL=https://free.v36.cm

# 默认使用的模型（默认为 gpt-4o-mini）
FREE_GPT_DEFAULT_MODEL=gpt-4o-mini

# 默认温度参数（0-2，默认 0.7，值越高越随机）
FREE_GPT_TEMPERATURE=0.7

# 默认最大 token 数（默认 2048）
FREE_GPT_MAX_TOKENS=2048

# ──────────────────────────────────────────────────────────────
# 示例配置
# ──────────────────────────────────────────────────────────────

# 使用 gpt-3.5-turbo 作为默认模型
# FREE_GPT_DEFAULT_MODEL=gpt-3.5-turbo

# 启用更有创造性的输出
# FREE_GPT_TEMPERATURE=1.2

# 使用更长的上下文窗口
# FREE_GPT_MAX_TOKENS=4096

# 使用联网搜索模型（可获取实时信息）
# FREE_GPT_DEFAULT_MODEL=net-gpt-3.5-turbo
